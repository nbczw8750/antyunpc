---
/**
 * 四步上手：时间轴形式的四个步骤，
 * 顺序为下载客户端、一键登录、快速实名、选游戏即刻开玩。
 * 步骤节点为绿色发光圆形；相邻节点由 li 伪元素绘制的连接轨相连，
 * 悬停时已走轨段点亮（规则见 global.css 的 .step 段）。
 * h3/p 不再携带 text-heading/text-body 工具类：基色分别由 base 层
 * 标题规则与 body 继承给出（色值相同），避免工具类压过 .step 悬停变色。
 */
import { COPY } from '../../data/copy';
import { STEPS } from '../../data/content';
import { SECTION_IDS } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
import BackgroundFX from '../ui/BackgroundFX.astro';
---

<section id={SECTION_IDS.steps} class="relative overflow-hidden py-20 sm:py-24">
  <BackgroundFX
    auras={[
      { variant: 'neon', className: 'left-1/2 top-[-8rem] h-[24rem] w-[24rem] -translate-x-1/2', opacity: 0.12 },
    ]}
  />

  <div class="shell relative z-10 flex flex-col gap-12">
    <SectionHeading
      kicker={COPY.steps.kicker}
      title={COPY.steps.title}
      subtitle={COPY.steps.subtitle}
    />

    <ol class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        STEPS.map((step) => (
          <li class="step flex gap-4 lg:flex-col lg:items-center lg:text-center">
            <span class="step-node shrink-0" aria-hidden="true">
              {String(step.order).padStart(2, '0')}
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="text-base font-bold">{step.title}</h3>
              <p class="text-sm leading-relaxed">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>