---
/**
 * 首屏 Banner：占满视口高度，含主标题、产品简介、主下载按钮与四张平台下载卡。
 * 下载卡区分两种状态：Windows 高亮展示、标注「一期开放」（下载地址接入前不提供跳转）；
 * macOS / Android / H5 为降饱和描边、标注「敬请期待」且不含可用链接。
 * 背景的网格与光晕全部由 CSS 生成。
 */
import { COPY } from '../../data/copy';
import { SECTION_IDS } from '../../data/site';
import { PLATFORMS } from '../../data/platforms';
import BackgroundFX from '../ui/BackgroundFX.astro';
import StatusBadge from '../ui/StatusBadge.astro';
---

<section
  id={SECTION_IDS.hero}
  class="relative flex min-h-screen items-center overflow-hidden pt-24 pb-20"
>
  <BackgroundFX
    grid="floor"
    auras={[
      { variant: 'neon', className: '-left-32 top-[-6rem] h-[26rem] w-[26rem]', opacity: 0.16 },
      { variant: 'blue', className: 'right-[-8rem] top-10 h-[24rem] w-[24rem]', opacity: 0.2 },
      { variant: 'violet', className: 'bottom-[-10rem] left-1/3 h-[28rem] w-[28rem]', opacity: 0.18 },
    ]}
  />

  <div class="shell relative z-10">
    <div class="flex flex-col items-center gap-6 text-center">
      <p class="section-kicker">{COPY.hero.kicker}</p>
      <h1 class="max-w-4xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
        {COPY.hero.title}
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-body sm:text-lg">
        {COPY.hero.subtitle}
      </p>

      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <button type="button" class="btn-neon">{COPY.hero.primaryCta}</button>
        <a href={`#${SECTION_IDS.features}`} class="btn-ghost">{COPY.hero.secondaryCta}</a>
      </div>

      <ul class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        {
          COPY.hero.badges.map((badge) => (
            <li class="text-xs tracking-wide text-body-dim">· {badge}</li>
          ))
        }
      </ul>
    </div>

    <!-- 四张平台下载卡 -->
    <ul class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        PLATFORMS.map((platform) => {
          const isLive = platform.status === 'available';
          const cardClass = isLive ? 'card-neon' : 'card-muted';
          const inner = (
            <>
              <div class="flex items-start justify-between gap-2">
                <span class="text-base font-bold text-heading">{platform.name}</span>
                <StatusBadge status={platform.status} label={platform.statusLabel} />
              </div>
              <p class="mt-3 text-sm text-body">{platform.note}</p>
              <p class="mt-4 text-xs tracking-wide text-body-dim">
                {platform.href ? '前往下载 →' : '暂不可下载'}
              </p>
            </>
          );

          return (
            <li>
              {isLive && platform.href ? (
                <a href={platform.href} class={`${cardClass} block h-full p-5`}>
                  {inner}
                </a>
              ) : (
                <div class={`${cardClass} block h-full p-5`}>{inner}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>